#!/usr/bin/env node
// Fake Antigravity CLI for tests. Mimics `agy --input-format stream-json --output-format stream-json`
// and `agy models`.
// Behaviour is selected with FAKE_AGY_MODE: echo (default) | slow | fail | error | big | stream | huge
// `agy models` output is selected with FAKE_AGY_MODELS_MODE: ok (default) | fail | empty
// A `--model` starting with "bad-" makes the run end with an ERROR result.
// Runs as an ES module (package.json has "type": "module").
import fs from "node:fs";

const argv = process.argv.slice(2);

if (argv[0] === "models") {
  const mm = process.env.FAKE_AGY_MODELS_MODE || "ok";
  process.stderr.write("Fetching available models...\n");
  if (mm === "fail") {
    process.stderr.write("fake failure: not signed in\n");
    process.exit(4);
  }
  if (mm === "ok") {
    process.stdout.write(
      "gemini-3.8-flash-high\tGemini 3.8 Flash (High)\n" +
        "gemini-3.8-flash-medium\tGemini 3.8 Flash (Medium)\n" +
        "gemini-3.8-flash-low\tGemini 3.8 Flash (Low)\n",
    );
  }
  process.exit(0);
}

const mode = process.env.FAKE_AGY_MODE || "echo";
const model = argv.includes("--model") ? argv[argv.indexOf("--model") + 1] : undefined;
if (process.env.FAKE_AGY_PIDFILE) fs.writeFileSync(process.env.FAKE_AGY_PIDFILE, String(process.pid));
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => (input += c));
process.stdin.on("end", async () => {
  const out = (ev) => process.stdout.write(JSON.stringify(ev) + "\n");
  const result = (r) => out({ event: "result", result: { conversation_id: "fake", num_turns: 1, ...r } });
  const delta = (text, state = "ACTIVE") =>
    out({
      event: "step_update",
      step_update: { conversation_id: "fake", step_index: 1, state, step_type: "agent_response", text_delta: text },
    });
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

  const msg = JSON.parse(input.trim().split("\n")[0]);
  const content = msg.message.content;

  if (model && model.startsWith("bad-")) {
    result({ status: "ERROR", response: "", error: `invalid model selection: ${model}` });
    process.exit(1);
  }
  if (mode === "slow") {
    setTimeout(() => result({ status: "SUCCESS", response: "too late" }), 60_000);
    return;
  }
  if (mode === "fail") {
    process.stderr.write("fake failure: not signed in\n");
    process.exit(3);
  }
  if (mode === "error") {
    process.stderr.write("error: invalid model selection\n");
    result({ status: "ERROR", response: "", error: "invalid model selection" });
    process.exit(1);
  }
  if (mode === "big") {
    result({ status: "SUCCESS", response: "y".repeat(200 * 1024) });
    return;
  }
  if (mode === "stream") {
    // 8 deltas of 10 chars, 80 ms apart, then the result.
    for (let i = 0; i < 8; i++) {
      delta("0123456789");
      await sleep(80);
    }
    delta("\n", "DONE");
    result({ status: "SUCCESS", response: "0123456789".repeat(8) + "\n" });
    return;
  }
  if (mode === "huge") {
    // >10 MB of streamed deltas before the result event (the old buffer cap lost the result).
    const piece = "h".repeat(64 * 1024);
    for (let i = 0; i < 180; i++) {
      if (!process.stdout.write(JSON.stringify({ event: "step_update", step_update: { text_delta: piece } }) + "\n")) {
        await new Promise((r) => process.stdout.once("drain", r));
      }
    }
    result({ status: "SUCCESS", response: "survived huge stream" });
    return;
  }
  // echo: report args and the received prompt
  out({ event: "init", conversation_id: "fake", init: { cwd: process.cwd() } });
  result({
    status: "SUCCESS",
    response:
      JSON.stringify({
        args: argv,
        cwd: process.cwd(),
        promptLength: content.length,
        prompt: content.length > 10_000 ? content.slice(0, 100) : content,
      }) + "\n",
  });
});
